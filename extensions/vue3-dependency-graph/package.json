{
    "$schema": "./@types/schema/package/index.json",
    "package_version": 2,
    "name": "vue3-dependency-graph",
    "version": "1.0.0",
    "author": "Cocos Creator",
    "editor": ">=3.8.3",
    "scripts": {
        "preinstall": "node ./scripts/preinstall.js",
        "build": "tsc"
    },
    "description": "i18n:vue3-dependency-graph.description",
    "main": "./dist/main.js",
    "dependencies": {
        "@types/echarts": "^4.9.22",
        "@types/opener": "^1.4.3",
        "echarts": "^5.6.0",
        "fs-extra": "^10.0.0",
        "opener": "^1.5.2",
        "ssh2-sftp-client": "^12.0.0",
        "vue": "^3.1.4"
    },
    "devDependencies": {
        "@cocos/creator-types": "^3.8.3",
        "@types/fs-extra": "^9.0.5",
        "@types/node": "^18.17.1",
        "@types/ssh2-sftp-client": "^9.0.4",
        "typescript": "^4.9.5"
    },
    "panels": {
        "default": {
            "title": "vue3-dependency-graph Default Panel",
            "type": "dockable",
            "main": "dist/panels/default",
            "size": {
                "min-width": 400,
                "min-height": 300,
                "width": 1024,
                "height": 600
            }
        },
        "publish-process": {
            "title": "vue3-dependency-graph Publish Process",
            "type": "dockable",
            "main": "dist/panels/publishProcess",
            "size": {
                "min-width": 600,
                "min-height": 900,
                "width": 900,
                "height": 1300
            }
        },
        "open-tabspanel": {
            "title": "vue3-dependency-graph Open Tabs Panel",
            "type": "dockable",
            "main": "dist/panels/tabsDemo",
            "size": {
                "min-width": 600,
                "min-height": 900,
                "width": 900,
                "height": 850
            }
        }
    },
    "contributions": {
        "menu": [
            {
                "path": "publish-tools",
                "label": "open_panel",
                "message": "open-panel"
            },
            {
                "path": "publish-tools",
                "label": "process_PublishFlow",
                "message": "process_PublishFlow"
            },
            {
                "path": "publish-tools",
                "label": "publish_process",
                "message": "open-publish-process-panel"
            },
            {
                "path": "dep-check",
                "label": "dep-check",
                "message": "process_depCheck"
            },
            {
                "path": "publish-tools",
                "label": "open_tabspanel",
                "message": "open-tabspanel"
            }
        ],
        "messages": {
            "open-panel": {
                "methods": [
                    "openPanel"
                ]
            },
            "open-publish-process-panel": {
                "methods": [
                    "openPublishProcessPanel"
                ]
            },
            "process_PublishFlow": {
                "methods": [
                    "processPublishFlow"
                ]
            },
            "process_depCheck": {
                "methods": [
                    "processDepCheck"
                ]
            },
            "open-tabspanel": {
                "methods": [
                    "openTabsPanel"
                ]
            }
        }
    }
}
